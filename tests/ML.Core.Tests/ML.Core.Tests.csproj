<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- 测试方法名故意用中文加下划线：读起来比 TakeVersion_ParsesLegacyFormat 清楚得多。 -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- 用 Kestrel 起本地测试服务器。不用 HttpListener：非管理员注册 URL ACL 会失败。 -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ML.Core\ML.Core.csproj" />
    <ProjectReference Include="..\..\src\ML.Features\ML.Features.csproj" />
    <ProjectReference Include="..\..\src\ML.Plugin.Runtime\ML.Plugin.Runtime.csproj" />
  </ItemGroup>

</Project>